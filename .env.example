# tac-engine environment template.
# Copy to `.env` and set the values you need. `.env` is gitignored — never commit it.
# Real process environment always wins over `.env` (dotenvy does not override
# already-set variables).

# ---- Alpaca API credentials: OPTIONAL (set both or neither) ----
# Omit both for Yahoo daily stock history and free daily FX fallback. Account/order
# tools and Alpaca-only market data (intraday, quotes, options, streams) need keys.
# Generate free keys at https://alpaca.markets (paper trading API).
APCA_API_KEY_ID=your-alpaca-api-key-id
APCA_API_SECRET_KEY=your-alpaca-api-secret-key

# ---- Alpaca endpoints: optional (paper trading defaults) ----
# Live trading: https://api.alpaca.markets
# APCA_BASE_URL=https://paper-api.alpaca.markets
# APCA_DATA_BASE_URL=https://data.alpaca.markets
# APCA_STREAM_BASE_URL=wss://stream.data.alpaca.markets

# ---- Data lake root: REQUIRED ----
# Absolute path to the local parquet+DuckDB lake. Must be an absolute path —
# `~` and `$HOME` are NOT expanded.
TAC_LAKE_DIR=/absolute/path/to/lake

# ---- Optional tuning ----
# Earliest date tac-engine will backfill from (default 2000-01-03).
# TAC_LAKE_START_DATE=2000-01-03

# Set to 1 to disable the Yahoo Finance daily-bar history fallback.
# TAC_YAHOO_DISABLED=1

# Free FRED API key, only needed for loading macro symbols (market=MACRO).
# https://fred.stlouisfed.org/docs/api/api_key.html
# FRED_API_KEY=your-fred-api-key

# Log filter for tracing-subscriber (default info). e.g. tac_engine=debug,warn
# RUST_LOG=tac_engine=debug
